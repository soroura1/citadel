# Copy to /opt/citadel/citadel/.env on the VPS and fill in. VPS-OWNED: CI never
# writes this file, so a release that adds a required variable here must be
# applied by hand before that release deploys.
#
# HOST_APP_PORT is 8087 because 8085 was taken by another platform's adminer
# and 8086 is checklist-api's api-router. Confirm before changing:
#     ss -tlnp | grep ':8087 '
APP_BASE_URL=https://citadel.endura-assess.com
HOST_BIND_IP=172.17.0.1
HOST_APP_PORT=8087

# Where citadel's Caddy proxies /api/content. This is checklist-api's api-router
# on its published host port - same origin from the browser's point of view,
# which is what lets the session cookie travel.
# By service name on the shared `citadel` network — NOT a host IP. web and
# api-router are both on it; 172.17.0.1 is unroutable from a user-defined network.
API_UPSTREAM=api-router:8085

# citadel's own database — R3 Phase D. ⚠️ ADDING THESE BREAKS AN EXISTING
# DEPLOYMENT until /opt/citadel/citadel/.env is edited by hand. That is trap
# T25, and deploy.sh stops with the variable named rather than half-configuring.
OWNER_DB_PASSWORD=set-me
APP_DB_PASSWORD=set-me
